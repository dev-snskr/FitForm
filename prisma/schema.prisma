// FitForm Prisma Schema
// SQLite file-based database for local zero-config operation

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             Int               @id @default(autoincrement())
  name           String
  age            Int
  gender         String
  heightCm       Float
  weightKg       Float
  targetWeightKg Float?
  waistCm        Float?
  goal           String
  experience     String
  daysPerWeek    Int
  isDemo         Boolean           @default(false)
  createdAt      DateTime          @default(now())
  workoutDays    WorkoutDay[]
  logs           WorkoutLog[]
  dietPlans      DietPlan[]
  weightEntries  WeightEntry[]
  badges         UserBadge[]
  feedbacks      WorkoutFeedback[]
}

model WorkoutDay {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayNumber   Int
  workoutType String
  isRest      Boolean
  exercises   DayExercise[]

  @@unique([userId, dayNumber])
}

model DayExercise {
  id            Int        @id @default(autoincrement())
  workoutDayId  Int
  workoutDay    WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exerciseName  String
  targetMuscles String
  sets          Int
  reps          Int
  durationSecs  Int?
  restSeconds   Int
  formTrackable Boolean
  orderIndex    Int
}

model WorkoutLog {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName        String
  dayNumber       Int
  exercise        String
  setNumber       Int
  reps            Int
  loadKg          Float?   // Optional load/weight used in kg (null or empty means bodyweight)
  durationSeconds Int?     // Duration in seconds for timed exercises (e.g. Plank)
  formScore       Float?
  mistakes        String   // JSON string or comma-separated list of mistakes
  restSeconds     Int
  mode            String   // "live_camera", "manual", or "video_upload"
  completedAt     DateTime @default(now())
}

model DietPlan {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  budget         Float
  dietType       String   // "vegetarian" | "eggetarian" | "non-vegetarian"
  excludedFoods  String   // JSON string of excluded food IDs
  targetCalories Int
  targetProtein  Float
  totalCost      Float
  totalCalories  Int
  totalProtein   Float
  mealsJson      String   // JSON array of meals with food items
  createdAt      DateTime @default(now())
}

model WeightEntry {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg   Float
  waistCm    Float?   // Optional waist circumference in cm
  chestCm    Float?   // Optional chest circumference in cm
  hipsCm     Float?   // Optional hips circumference in cm
  armCm      Float?   // Optional arm circumference in cm
  date       String   // "YYYY-MM-DD" local calendar date
  recordedAt DateTime @default(now())

  @@unique([userId, date])
}

model UserBadge {
  id       Int      @id @default(autoincrement())
  userId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String   // Matches unique identifier in badgesConfig.ts
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model WorkoutFeedback {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayNumber Int
  rpeScore  Int      // 1: Very Easy, 2: Easy, 3: Moderate, 4: Hard, 5: Very Hard
  feedback  String?
  createdAt DateTime @default(now())

  @@unique([userId, dayNumber])
}
